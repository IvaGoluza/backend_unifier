	<parameter name="deal_id" class="java.lang.Integer">
		<parameterDescription><![CDATA[Deal id]]></parameterDescription>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT 
 COALESCE(o.name, p.first_name || ' ' || p.last_name) AS user_name,
 r.volunteer_position,
 u.volunteer_center,
 to_char(r.start_date, 'DD.MM.YYYY.') as start_date,
 to_char(r.end_date, 'DD.MM.YYYY.') as end_date,
 r.volunteer_work_description,
 to_char(CURRENT_DATE, 'DD.MM.YYYY.') AS today
FROM recension r
LEFT JOIN person p ON r.reviewing_user_id = p.id
LEFT JOIN organization o ON r.reviewing_user_id = o.id
JOIN users u ON r.reviewing_user_id = u.id
WHERE r.deal_id = $P{deal_id}]]>
	</queryString>
